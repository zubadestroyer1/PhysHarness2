+    def _read_notes_one(self, session, record, reader):
+        if record.payload.get("context_format") != NOTES_FORMAT:
+            raise _error(
+                "CONTEXT_NOT_ISSUED", "Artifact is not an issued research-notes checkpoint."
+            )
